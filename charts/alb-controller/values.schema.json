{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "ALB Controller Helm Chart Values Schema",
  "type": "object",
  "required": ["albController"],
  "properties": {
    "albController": {
      "type": "object",
      "required": ["namespace", "image", "controller"],
      "properties": {
        "namespace": {
          "type": "string",
          "title": "Namespace",
          "description": "Namespace to deploy alb-controller components",
          "default": "azure-alb-system"
        },
        "env": {
          "type": "array",
          "title": "Environment Variables",
          "description": "Environment variables for alb-controller",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["name", "value"]
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "title": "Image Pull Secrets",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "image": {
          "type": "object",
          "required": ["registry", "pullPolicy", "name"],
          "properties": {
            "registry": { "type": "string", "default": "mcr.microsoft.com" },
            "pullPolicy": { "type": "string", "enum": ["Always","IfNotPresent","Never"], "default": "IfNotPresent" },
            "tag": { "type": "string" },
            "name": {
              "type": "object",
              "required": ["controller", "CRDs", "bootstrap"],
              "properties": {
                "controller": { "type": "string", "default": "application-lb/images/alb-controller" },
                "CRDs": { "type": "string", "default": "application-lb/images/alb-controller-crds" },
                "bootstrap": { "type": "string", "default": "application-lb/images/alb-controller-bootstrap" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "logLevel": {
          "type": "string",
          "enum": ["panic", "fatal", "error", "warn", "info", "debug", "trace", "disabled"],
          "default": "info"
        },
        "installGatewayApiCRDs": { "type": "boolean", "default": true },
        "securityPolicyFeatureFlag": { "type": "boolean", "default": true },
        "ipAccessRulesFeatureFlag": { "type": "boolean", "default": false },
        "podIdentity": {
          "type": "object",
          "required": ["clientID"],
          "properties": {
            "clientID": { "type": "string", "default": "" }
          },
          "additionalProperties": false
        },
        "controller": {
          "type": "object",
          "required": ["resource"],
          "properties": {
            "nodeSelector": {
              "type": "object",
              "default": { "kubernetes.io/os": "linux" }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "operator": { "type": "string", "enum": ["Equal","Exists"], "default": "Equal" },
                  "value": { "type": "string" },
                  "effect": { "type": "string", "enum": ["NoSchedule","PreferNoSchedule","NoExecute"] },
                  "tolerationSeconds": { "type": "integer" }
                }
              },
              "default": []
            },
            "replicaCount": { "type": "integer", "default": 2 },
            "resource": {
              "type": "object",
              "required": ["limits","requests"],
              "properties": {
                "limits": {
                  "type": "object",
                  "required": ["cpu","memory"],
                  "properties": {
                    "cpu": { "type": "string", "pattern": "^(\\d+)(m)?$" },
                    "memory": { "type": "string", "pattern": "^(\\d+)(Mi|Gi)?$" }
                  },
                  "additionalProperties": false
                },
                "requests": {
                  "type": "object",
                  "required": ["cpu","memory"],
                  "properties": {
                    "cpu": { "type": "string", "pattern": "^(\\d+)(m)?$" },
                    "memory": { "type": "string", "pattern": "^(\\d+)(Mi|Gi)?$" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "init": {
          "type": "object",
          "required": ["resource"],
          "properties": {
            "resource": {
              "type": "object",
              "required": ["limits","requests"],
              "properties": {
                "limits": {
                  "type": "object",
                  "required": ["cpu","memory"],
                  "properties": {
                    "cpu": { "type": "string", "pattern": "^(\\d+)(m)?$" },
                    "memory": { "type": "string", "pattern": "^(\\d+)(Mi|Gi)?$" }
                  }
                },
                "requests": {
                  "type": "object",
                  "required": ["cpu","memory"],
                  "properties": {
                    "cpu": { "type": "string", "pattern": "^(\\d+)(m)?$" },
                    "memory": { "type": "string", "pattern": "^(\\d+)(Mi|Gi)?$" }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
